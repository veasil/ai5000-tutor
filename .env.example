# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://ai5000:ai5000@localhost:5432/ai5000_tutor?schema=public"

# Anthropic is optional in local MVP mode.
# When omitted, /api/tutor/[journeyId] returns a local fallback guide message.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# WQT integration.
# NEXT_PUBLIC_WQT_LEVEL1_URL can point directly at the deployed playable WQT page.
NEXT_PUBLIC_WQT_BASE_URL="https://wqt-auth-backend.zeabur.app"
NEXT_PUBLIC_WQT_LEVEL1_URL="https://wqt-auth-backend.zeabur.app/"
WQT_CALLBACK_SECRET=""

# Auth placeholders for the upcoming full NextAuth/JWT implementation.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
